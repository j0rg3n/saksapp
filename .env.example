# Local paths for working data. Copy to .env (untracked). Keep this data OUTSIDE the repository.
# Unset values fall back to the in-repo paths used on the VM.
SAKSAPP_AUTH_DIR=/home/YOU/.config/saksapp
SAKSAPP_DB_DIR=/home/YOU/saksapp-data/db
SAKSAPP_KEYS_DIR=/home/YOU/saksapp-data/dp_keys
SAKSAPP_CADDY_DATA_DIR=/home/YOU/saksapp-data/caddy_data
SAKSAPP_CADDY_CONFIG_DIR=/home/YOU/saksapp-data/caddy_config
